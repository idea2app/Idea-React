{
    "compilerOptions": {
        "target": "ES6",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "downlevelIteration": true,
        "useDefineForClassFields": true,
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "lib": ["ES2024", "DOM"]
    },
    "include": ["*.ts", "source/**/*"],
    "typedocOptions": {
        "name": "Idea React",
        "includeVersion": true,
        "excludeExternals": true,
        "excludePrivate": true,
        "plugin": ["typedoc-plugin-mdn-links"],
        "readme": "./ReadMe.md",
        "navigationLinks": {
            "GitHub": "https://github.com/idea2app/Idea-React"
        }
    }
}
