{
    "name": "idea-react",
    "version": "2.3.1",
    "license": "LGPL-3.0-or-later",
    "author": "shiy2008@gmail.com",
    "description": "A React advanced components library based on TypeScript & Bootstrap, built by idea2app remote developers team.",
    "keywords": [
        "react",
        "component",
        "typescript",
        "bootstrap"
    ],
    "homepage": "https://idea2app.github.io/Idea-React/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/idea2app/Idea-React.git"
    },
    "bugs": {
        "url": "https://github.com/idea2app/Idea-React/issues"
    },
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "module": "dist/index.mjs",
    "main": "dist/index.js",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
    },
    "dependencies": {
        "@editorjs/editorjs": "^2.31.6",
        "@editorjs/paragraph": "^2.11.7",
        "@react-editor-js/core": "^2.1.0",
        "@shikijs/langs": "^4.4.2",
        "@shikijs/themes": "^4.4.2",
        "@swc/helpers": "^0.5.23",
        "classnames": "^2.5.1",
        "editorjs-html": "^4.0.5",
        "html2canvas": "^1.4.1",
        "iterable-observer": "^1.1.0",
        "lodash": "^4.18.1",
        "mobx-react-helper": "^0.5.3",
        "react-bootstrap": "^2.10.10",
        "react-editor-js": "^2.1.0",
        "react-live": "^4.1.8",
        "shiki": "^4.4.2",
        "web-utility": "^4.7.2"
    },
    "peerDependencies": {
        "mobx": ">=6",
        "mobx-react": ">=9",
        "react": ">=16",
        "react-dom": ">=16.4.2",
        "react-element-to-jsx-string": ">=15"
    },
    "devDependencies": {
        "@cspell/eslint-plugin": "^10.0.1",
        "@eslint/js": "^10.0.1",
        "@parcel/config-default": "~2.16.4",
        "@parcel/packager-ts": "~2.16.4",
        "@parcel/transformer-less": "2.16.4",
        "@parcel/transformer-typescript-tsc": "~2.16.4",
        "@parcel/transformer-typescript-types": "~2.16.4",
        "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
        "@tsdown/css": "^0.22.14",
        "@types/lodash": "^4.17.25",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "buffer": "^6.0.3",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "koapache": "^3.0.0",
        "less": "^4.8.1",
        "lint-staged": "^17.3.0",
        "mobx": "^7.0.0",
        "mobx-react": "^10.0.0",
        "parcel": "~2.16.4",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "prettier-plugin-css-order": "^2.2.0",
        "process": "^0.11.10",
        "prop-types": "15.8.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-element-to-jsx-string": "^17.0.1",
        "rimraf": "^6.1.3",
        "tsdown": "^0.22.14",
        "typedoc": "^0.28.20",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.66.0"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4,
        "printWidth": 100,
        "plugins": [
            "prettier-plugin-css-order",
            "@softonus/prettier-plugin-duplicate-remover"
        ]
    },
    "lint-staged": {
        "*.{md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
        "*.{js,ts,tsx}": "eslint --fix"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
    "targets": {
        "main": {
            "optimize": true
        },
        "module": {
            "optimize": true
        }
    },
    "@parcel/resolver-default": {
        "packageExports": true
    },
    "scripts": {
        "prepare": "husky",
        "test": "lint-staged",
        "pack-preview": "cd preview/  &&  rimraf ../.parcel-cache dist/  &&  parcel build --public-url=. --dist-dir=../docs/preview/",
        "pack-docs": "rimraf docs/  &&  typedoc source/",
        "pack-dist": "tsdown source/index.ts --format cjs --format esm --target es2015 --platform browser --minify --dts --clean --logLevel error",
        "start": "npm run pack-docs  &&  npm run pack-preview  &&  web-server docs/ -p 8080 -o",
        "build": "npm run pack-docs  &&  npm run pack-preview  &&  npm run pack-dist",
        "prepublishOnly": "npm test  &&  npm run build",
        "preview": "cd preview/  &&  rimraf ../.parcel-cache dist/  &&  parcel --open"
    }
}
