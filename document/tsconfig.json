{
    "compilerOptions": {
        "allowJs": false,
        "strict": true,
        "target": "ES2017",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "skipLibCheck": true,
        "incremental": true,
        "noEmit": true,
        "types": ["vinext/types", "node"],
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.mts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "../source/types.d.ts"
    ],
    "exclude": ["node_modules"]
}
